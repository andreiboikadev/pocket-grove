# =============================================================
#  Unity .gitignore
#  Base: github/gitignore -> Unity.gitignore
#  Project extras: *.slnx, /ProfilerCaptures/, .vscode/
# =============================================================

# --- Unity-generated, machine-local folders (never commit) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size and may contain sensitive data
/[Mm]emoryCaptures/

# Recordings / Profiler captures (project extra)
/[Rr]ecordings/
/[Pp]rofilerCaptures/

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- IDE / editor caches ---
.vs/
# VS components manifest — optional, Unity regenerates it locally
.vsconfig
.idea/
.vscode/
.gradle/
.consulo/
ExportedObj/

# --- Autogenerated solution / project files (Unity recreates these) ---
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta files of the autogenerated files above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash report
sysinfo.txt

# --- Build outputs ---
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
